NEXT_PUBLIC_SITE_URL=https://saltet.dk

# Supabase (påkrævet for stjerne-ratings i produktion)
# Project: https://supabase.com/dashboard — Settings → API
# Kør supabase/recipe-ratings.sql i SQL Editor før go-live.
# Sæt de samme værdier i Vercel → Settings → Environment Variables
# (Production + Preview), derefter redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Valgfri lokal MantleDB-fallback (kun når NODE_ENV != production og ikke Vercel).
# MANTLE_RECIPE_RATINGS_ENABLED=1
